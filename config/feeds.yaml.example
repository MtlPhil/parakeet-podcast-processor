# Copy to config/feeds.yaml (or run `p3 init`) and edit to taste.
# The web UI's Settings page reads and writes the same file.

feeds:
  - name: "Lenny's Podcast"
    url: "https://api.substack.com/feed/podcast/10845.rss"
    category: "product"
  # YouTube works too: a channel (@handle, /channel/UC..., /c/, /user/), a
  # single video, or a playlist (each video becomes its own source). Shorts
  # and livestreams are skipped. Needs deno on PATH: brew install deno
  # - name: "Some Channel"
  #   url: "https://www.youtube.com/@somechannel"
  #   category: "ai"

settings:
  # Downloads
  max_episodes_per_feed: 3     # also caps each YouTube channel fetch
  audio_format: wav            # wav or mp3

  # Transcription (Apple Silicon): the language is detected per episode;
  # Parakeet handles parakeet_languages, Whisper (MLX) everything else
  parakeet_enabled: true
  parakeet_model: "mlx-community/parakeet-tdt-0.6b-v3"
  parakeet_languages: [en]
  whisper_model: turbo         # turbo, large, medium, small, base, tiny
  # Unload Ollama's models (and wait until they're gone) before transcribing,
  # so the LLM and the transcription models never share memory
  release_ollama_before_transcription: true

  # LLM used for cleaning, summaries and writing: ollama, openai or gemini
  llm_provider: ollama
  llm_model: "gemma4:12b"
  ollama_base_url: "http://localhost:11434"
  # Model used when the provider is gemini (key: GEMINI_API_KEY or
  # config/gemini_api_key.txt). OpenAI reads OPENAI_API_KEY.
  gemini_model: "gemini-3.8-flash"

  # Mail server for the daily run's emailed report (each user turns it on and
  # sets their address in Settings). The password is read from SMTP_PASSWORD
  # or config/smtp_password.txt. Port 587 uses STARTTLS, 465 implicit TLS.
  # smtp_host: "smtp.gmail.com"
  # smtp_port: 587
  # smtp_user: "you@example.com"
  # smtp_from: "you@example.com"

  # Each user's daily run time, writing tone, language and writing LLM are
  # personal settings, set on the web app's Settings page. The LLM settings
  # above summarize every episode (once, for everyone) and are the default
  # for users who haven't picked their own.

  # Default formats for `p3 export`: markdown, json, html
  export_format:
    - markdown
    - json
